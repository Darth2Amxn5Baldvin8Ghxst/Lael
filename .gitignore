# ============================================================================
# LAEL TRADING SYSTEM — .gitignore
# "Blood of my blood. What stays local, stays local."
# ============================================================================

# ---------- Dependencies (regenerated by npm install) ----------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/install-state.gz
package-lock.json.bak

# ---------- Build artifacts (regenerated by npm run build) ----------
dist/
**/dist/
dist-cjs/
**/dist-cjs/
build/
**/build/
out/
**/out/
*.tsbuildinfo
*.d.ts.map
*.js.map

# ---------- Local LLM model weights (downloaded via ollama pull) ----------
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# ---------- Tools downloaded externally (not source) ----------
tools/ngrok.exe
tools/ngrok-*.zip
tools/*.exe
tools/*.zip
tools/*.tar.gz

# ---------- Live OpenClaw config (CONTAINS BOT TOKEN — never commit) ----------
.openclaw/openclaw.json
.openclaw/credentials/
.openclaw/identity/
.openclaw/devices/
.openclaw/sessions/
.openclaw/memory/
.openclaw/completions/
.openclaw/canvas/
.openclaw/cron/
.openclaw/logs/
.openclaw/telegram/
.openclaw/workspace/
.openclaw/agents/
.openclaw/exec-approvals.json
.openclaw/update-check.json
.openclaw/gateway.cmd

# ---------- Secrets ----------
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
.secrets/

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- OS junk ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editor / IDE ----------
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- VSCode extension cruft (the .sixth folder you're removing) ----------
.sixth/

# ---------- Caches ----------
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/
.swc/
.eslintcache
.stylelintcache

# ---------- Coverage / test artifacts ----------
coverage/
*.lcov
.nyc_output/
junit.xml
test-results/

# ---------- Temp ----------
tmp/
temp/
*.tmp
*.bak
*.orig

# ---------- MT5 compiled EA artifact (keep .mq5 source, exclude .ex5 binary) ----------
mt5/*.ex5
mt5/Tester/
mt5/Files/

# ---------- ngrok / tunnel config (lives in user profile but if it ever lands here) ----------
ngrok.yml
ngrok.exe

# ---------- PowerShell / shell history ----------
PSReadLine/
.bash_history
.zsh_history

# ---------- Python (in case any scripts get added) ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# ---------- Lockfile policy ----------
# Keep your primary package manager lockfile committed; ignore the rest.
# Uncomment if you settle on one. Defaults below keep all and let you choose.
# yarn.lock
# pnpm-lock.yaml
